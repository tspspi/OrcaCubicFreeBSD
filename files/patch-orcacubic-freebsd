@@ -0,0 +1,86 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include "libslic3r/TextureToColor/TextureDecode.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <jpeglib.h>
+#include <png.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(void)
+{
+    const unsigned char pixels[12] = {
+        255, 0, 0,   0, 255, 0,
+        0, 0, 255,   255, 255, 255
+    };
+
+    png_image png;
+    memset(&png, 0, sizeof(png));
+    png.version = PNG_IMAGE_VERSION;
+    png.width = 2;
+    png.height = 2;
+    png.format = PNG_FORMAT_RGB;
+    size_t png_size = 0;
+    assert(png_image_write_to_memory(&png, NULL, &png_size, 0, pixels, 0, NULL));
+    unsigned char* png_data = (unsigned char*)malloc(png_size);
+    assert(png_data);
+    assert(png_image_write_to_memory(&png, png_data, &png_size, 0, pixels, 0, NULL));
+    TextureDecodedRGB decoded = {0};
+    assert(decode_texture_rgb(png_data, png_size, &decoded));
+    assert(decoded.width == 2 && decoded.height == 2);
+    assert(memcmp(decoded.pixels, pixels, sizeof(pixels)) == 0);
+    free_texture_decoded_rgb(&decoded);
+    free(png_data);
+
+    // An alpha channel must be discarded, not composited over black.
+    const unsigned char transparent_red[4] = {255, 0, 0, 0};
+    png.format = PNG_FORMAT_RGBA;
+    png.width = 1;
+    png.height = 1;
+    png_size = 0;
+    assert(png_image_write_to_memory(&png, NULL, &png_size, 0, transparent_red, 0, NULL));
+    png_data = (unsigned char*)malloc(png_size);
+    assert(png_data);
+    assert(png_image_write_to_memory(&png, png_data, &png_size, 0, transparent_red, 0, NULL));
+    assert(decode_texture_rgb(png_data, png_size, &decoded));
+    assert(decoded.width == 1 && decoded.height == 1);
+    assert(decoded.pixels[0] == 255 && decoded.pixels[1] == 0 && decoded.pixels[2] == 0);
+    free_texture_decoded_rgb(&decoded);
+    free(png_data);
+
+    struct jpeg_compress_struct compressor;
+    struct jpeg_error_mgr error;
+    compressor.err = jpeg_std_error(&error);
+    jpeg_create_compress(&compressor);
+    unsigned char* jpeg_data = NULL;
+    unsigned long jpeg_size = 0;
+    jpeg_mem_dest(&compressor, &jpeg_data, &jpeg_size);
+    compressor.image_width = 2;
+    compressor.image_height = 2;
+    compressor.input_components = 3;
+    compressor.in_color_space = JCS_RGB;
+    jpeg_set_defaults(&compressor);
+    jpeg_set_quality(&compressor, 100, TRUE);
+    jpeg_start_compress(&compressor, TRUE);
+    while (compressor.next_scanline < compressor.image_height) {
+        JSAMPROW row = (JSAMPROW)(pixels + compressor.next_scanline * 2 * 3);
+        jpeg_write_scanlines(&compressor, &row, 1);
+    }
+    jpeg_finish_compress(&compressor);
+    jpeg_destroy_compress(&compressor);
+    assert(decode_texture_rgb(jpeg_data, jpeg_size, &decoded));
+    assert(decoded.width == 2 && decoded.height == 2);
+    free_texture_decoded_rgb(&decoded);
+    free(jpeg_data);
+
+    const unsigned char corrupt_jpeg[] = {0xff, 0xd8, 0xff, 0xd9};
+    assert(!decode_texture_rgb(corrupt_jpeg, sizeof(corrupt_jpeg), &decoded));
+    assert(decoded.pixels == NULL);
+    const unsigned char not_an_image[] = {1, 2, 3, 4};
+    assert(!decode_texture_rgb(not_an_image, sizeof(not_an_image), &decoded));
+    return 0;
+}
diff --git a/tests/ObjColorUtilsTest.cpp b/tests/ObjColorUtilsTest.cpp
