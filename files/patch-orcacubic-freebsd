+// PNG and JPEG are decoded by libslic3r. Use wx's existing image handlers for
+// other OBJ/Assimp textures so removing OpenCV does not discard those formats.
+static void decode_other_texture_formats(Slic3r::TexturedMesh& mesh)
+{
+    static constexpr unsigned char png_signature[] = {0x89, 'P', 'N', 'G', '\r', '\n', 0x1a, '\n'};
+    for (auto& texture : mesh.textures) {
+        if ((texture.width > 0 && texture.height > 0) || texture.data.size() < 3)
+            continue;
+        const auto& encoded = texture.data;
+        if ((encoded.size() >= sizeof(png_signature) && std::memcmp(encoded.data(), png_signature, sizeof(png_signature)) == 0)
+            || (encoded[0] == 0xff && encoded[1] == 0xd8))
+            continue;
+
+        wxMemoryInputStream stream(encoded.data(), encoded.size());
+        wxImage image(stream, wxBITMAP_TYPE_ANY);
+        if (!image.IsOk() || !image.GetData())
+            continue;
+        const int width = image.GetWidth();
+        const int height = image.GetHeight();
+        const int channels = image.HasAlpha() ? 4 : 3;
+        if (width <= 0 || height <= 0
+            || std::size_t(width) > std::numeric_limits<std::size_t>::max() / std::size_t(height) / channels)
+            continue;
+
+        const std::size_t count = std::size_t(width) * height;
+        std::vector<unsigned char> raw(count * channels);
+        const unsigned char* rgb = image.GetData();
+        const unsigned char* alpha = image.HasAlpha() ? image.GetAlpha() : nullptr;
+        for (std::size_t i = 0; i < count; ++i) {
+            std::memcpy(raw.data() + i * channels, rgb + i * 3, 3);
+            if (alpha)
+                raw[i * channels + 3] = alpha[i];
+        }
+        texture.width = width;
+        texture.height = height;
+        texture.channels = channels;
+        texture.data = std::move(raw);
+    }
+}
