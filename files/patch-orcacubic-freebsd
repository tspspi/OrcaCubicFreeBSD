--- /dev/null
+++ b/deps/wxInspector/0001-wx-3.2-compat.patch
@@ -0,0 +1,141 @@
+From: OrcaCubic FreeBSD port
+Subject: [PATCH] Support wxWidgets 3.2
+
+wxInspector v1.0.0 uses wxWidgets 3.3 APIs that are not present in the
+wxWidgets 3.2 package provided by FreeBSD. Keep the newer APIs when they are
+available and use their 3.2 equivalents otherwise.
+
+---
+ src/highlighter.cpp       | 19 +++++++++++++++----
+ src/info.cpp              | 10 ++++++++--
+ src/method_registry.cpp   |  3 ++-
+ src/property_provider.cpp |  3 ++-
+ 4 files changed, 27 insertions(+), 8 deletions(-)
+
+diff --git a/src/highlighter.cpp b/src/highlighter.cpp
+index 7449233..9563c1d 100644
+--- a/src/highlighter.cpp
++++ b/src/highlighter.cpp
+@@ -2,7 +2,20 @@
+ #include <wx/window.h>
+ #include <wx/sizer.h>
+ #include <wx/toplevel.h>
++#include <wx/dcclient.h>
+ 
++#if wxCHECK_VERSION(3, 3, 0)
++#define WXINSPECTOR_OVERLAY_DC(name, overlay, window) \
++    wxOverlayDC name(overlay, window);                 \
++    name.Clear()
++#else
++#define WXINSPECTOR_OVERLAY_DC(name, overlay, window) \
++    wxClientDC name##_client(window);                  \
++    wxDCOverlay name##_overlay(overlay, &name##_client); \
++    name##_overlay.Clear();                            \
++    wxDC& name = name##_client
++#endif
++
+ namespace wxInspector {
+ 
+ static const int HIGHLIGHT_DURATION_MS = 3000;
+@@ -96,8 +109,7 @@ void InspectionHighlighter::DrawWindowHighlight(wxWindow* win)
+         // by the window system), wxOverlayDC draws through a transparent
+         // overlay window that stays on top until m_overlay.Reset().
+         wxWindow* tlwParent = wxGetTopLevelParent(win);
+-        wxOverlayDC dc(*m_overlay, tlwParent);
+-        dc.Clear();
++        WXINSPECTOR_OVERLAY_DC(dc, *m_overlay, tlwParent);
+         dc.SetPen(wxPen(*wxGREEN, 3));
+         dc.SetBrush(*wxTRANSPARENT_BRUSH);
+         wxPoint origin = tlwParent->ScreenToClient(win->GetScreenPosition());
+@@ -114,8 +126,7 @@ void InspectionHighlighter::DrawSizerHighlight(wxSizer* sizer, wxWindow* relati
+     // Use wxOverlayDC on the containing window — sizer positions are
+     // already relative to the containing window's client area, so no
+     // coordinate conversion is needed.
+-    wxOverlayDC dc(*m_overlay, relativeTo);
+-	dc.Clear();
++    WXINSPECTOR_OVERLAY_DC(dc, *m_overlay, relativeTo);
+ 
+     // Green outline for sizer boundary
+     dc.SetPen(wxPen(*wxGREEN, 2));
+@@ -149,8 +160,7 @@ void InspectionHighlighter::DrawSizerItemHighlight(wxSizerItem* item, wxWindow*
+         if (!relativeTo) return;
+ 
+         wxRect rect = item->GetRect();
+-        wxOverlayDC dc(*m_overlay, relativeTo);
+-        dc.Clear();
++        WXINSPECTOR_OVERLAY_DC(dc, *m_overlay, relativeTo);
+         dc.SetPen(wxPen(*wxGREEN, 2));
+         dc.SetBrush(*wxTRANSPARENT_BRUSH);
+         dc.DrawRectangle(rect);
+@@ -162,8 +172,7 @@ void InspectionHighlighter::DrawSizerItemHighlight(wxSizerItem* item, wxWindow*
+         if (!relativeTo) return;
+ 
+         wxRect rect = item->GetRect();
+-        wxOverlayDC dc(*m_overlay, relativeTo);
+-        dc.Clear();
++        WXINSPECTOR_OVERLAY_DC(dc, *m_overlay, relativeTo);
+         dc.SetPen(wxPen(*wxGREEN, 2));
+         dc.SetBrush(*wxTRANSPARENT_BRUSH);
+         dc.DrawRectangle(rect);
+diff --git a/src/info.cpp b/src/info.cpp
+index f2afe90..6bae087 100644
+--- a/src/info.cpp
++++ b/src/info.cpp
+@@ -1,4 +1,10 @@
+ #include "wx/inspector/info.h"
++
++#if wxCHECK_VERSION(3, 3, 0)
++#define WXINSPECTOR_READ_ONLY_FLAG wxPGFlags::ReadOnly
++#else
++#define WXINSPECTOR_READ_ONLY_FLAG wxPG_PROP_READONLY
++#endif
+ #include "wx/inspector/property_provider.h"
+ #include <wx/sizer.h>
+ #include <wx/toplevel.h>
+@@ -67,7 +73,7 @@ void InfoPanel::SetProperties(const wxVector<PropertyDef>& properties)
+         switch (prop.type) {
+         case PropertyType::ReadOnly:
+             pgProp = new wxStringProperty(prop.name, wxPG_LABEL, prop.value);
+-            pgProp->ChangeFlag(wxPGFlags::ReadOnly, true);
++            pgProp->ChangeFlag(WXINSPECTOR_READ_ONLY_FLAG, true);
+             break;
+         case PropertyType::Boolean:
+             pgProp = new wxBoolProperty(prop.name, wxPG_LABEL,
+@@ -109,7 +115,7 @@ void InfoPanel::SetProperties(const wxVector<PropertyDef>& properties)
+ 
+         if (pgProp) {
+             if (prop.readOnly) {
+-                pgProp->ChangeFlag(wxPGFlags::ReadOnly, true);
++                pgProp->ChangeFlag(WXINSPECTOR_READ_ONLY_FLAG, true);
+             }
+             // Store the setter in the property's client data
+             // We use a custom approach: store setter index in a map
+diff --git a/src/method_registry.cpp b/src/method_registry.cpp
+index 5cc69bf..0b22b4e 100644
+--- a/src/method_registry.cpp
++++ b/src/method_registry.cpp
+@@ -258,7 +258,8 @@ wxVector<MethodInfo> MethodRegistry::GetMethods(InspectableObject& obj) const
+     if (!obj.IsValid()) return result;
+     for (auto* plugin : m_plugins) {
+         wxVector<MethodInfo> m = plugin->GetMethods(obj);
+-        result.insert(result.end(), m.begin(), m.end());
++        for (const auto& method : m)
++            result.push_back(method);
+     }
+     return result;
+ }
+diff --git a/src/property_provider.cpp b/src/property_provider.cpp
+index 4db6d8d..7f31b7e 100644
+--- a/src/property_provider.cpp
++++ b/src/property_provider.cpp
+@@ -372,7 +372,8 @@ wxVector<PropertyDef> PropertyProvider::GetProperties(InspectableObject& obj) c
+     for (auto* plugin : m_plugins) {
+         if (plugin->CanProvideProperties(info)) {
+             wxVector<PropertyDef> p = plugin->GetProperties(obj);
+-            result.insert(result.end(), p.begin(), p.end());
++            for (const auto& property : p)
++                result.push_back(property);
+         }
+     }
+     return result;
+ }
