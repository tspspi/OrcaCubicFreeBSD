+#include "TextureDecode.h"
+
+#include <stdio.h>
+#include <jpeglib.h>
+#include <png.h>
+
+#include <limits.h>
+#include <setjmp.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct jpeg_error_context {
+    struct jpeg_error_mgr manager;
+    jmp_buf recovery;
+};
+
+static void jpeg_error_exit(j_common_ptr info)
+{
+    struct jpeg_error_context* context = (struct jpeg_error_context*)info->err;
+    longjmp(context->recovery, 1);
+}
+
+static int valid_dimensions(size_t width, size_t height)
+{
+    return width > 0 && height > 0 && width <= INT_MAX && height <= INT_MAX
+        && width <= SIZE_MAX / height / 3;
+}
+
+static int decode_png(const unsigned char* data, size_t size, TextureDecodedRGB* output)
+{
+    png_image image;
+    memset(&image, 0, sizeof(image));
+    image.version = PNG_IMAGE_VERSION;
+    if (!png_image_begin_read_from_memory(&image, data, size))
+        return 0;
+    image.format = PNG_FORMAT_RGBA;
+    if (!valid_dimensions(image.width, image.height)
+        || (size_t)image.width > SIZE_MAX / image.height / 4) {
+        png_image_free(&image);
+        return 0;
+    }
+    const size_t pixel_count = (size_t)image.width * image.height;
+    unsigned char* rgba = (unsigned char*)malloc(pixel_count * 4);
+    if (!rgba) {
+        png_image_free(&image);
+        return 0;
+    }
+    if (!png_image_finish_read(&image, NULL, rgba, 0, NULL)) {
+        free(rgba);
+        png_image_free(&image);
+        return 0;
+    }
+    unsigned char* pixels = (unsigned char*)malloc(pixel_count * 3);
+    if (!pixels) {
+        free(rgba);
+        png_image_free(&image);
+        return 0;
+    }
+    for (size_t i = 0; i < pixel_count; ++i) {
+        pixels[3 * i] = rgba[4 * i];
+        pixels[3 * i + 1] = rgba[4 * i + 1];
+        pixels[3 * i + 2] = rgba[4 * i + 2];
+    }
+    free(rgba);
+    output->pixels = pixels;
+    output->width = (int)image.width;
+    output->height = (int)image.height;
+    png_image_free(&image);
+    return 1;
+}
+
+static int decode_jpeg(const unsigned char* data, size_t size, TextureDecodedRGB* output)
+{
+    if (size > ULONG_MAX)
+        return 0;
+    struct jpeg_decompress_struct decoder;
+    struct jpeg_error_context error;
+    memset(&decoder, 0, sizeof(decoder));
+    decoder.err = jpeg_std_error(&error.manager);
+    error.manager.error_exit = jpeg_error_exit;
+    if (setjmp(error.recovery)) {
+        jpeg_destroy_decompress(&decoder);
+        free_texture_decoded_rgb(output);
+        return 0;
+    }
+    jpeg_create_decompress(&decoder);
+    jpeg_mem_src(&decoder, (unsigned char*)data, (unsigned long)size);
+    if (jpeg_read_header(&decoder, TRUE) != JPEG_HEADER_OK) {
+        jpeg_destroy_decompress(&decoder);
+        return 0;
+    }
+    decoder.out_color_space = JCS_RGB;
+    jpeg_start_decompress(&decoder);
+    if (decoder.output_components != 3
+        || !valid_dimensions(decoder.output_width, decoder.output_height)) {
+        jpeg_destroy_decompress(&decoder);
+        return 0;
+    }
+    output->width = (int)decoder.output_width;
+    output->height = (int)decoder.output_height;
+    output->pixels = (unsigned char*)malloc((size_t)output->width * output->height * 3);
+    if (!output->pixels) {
+        jpeg_destroy_decompress(&decoder);
+        return 0;
+    }
+    while (decoder.output_scanline < decoder.output_height) {
+        JSAMPROW row = output->pixels + (size_t)decoder.output_scanline * output->width * 3;
+        jpeg_read_scanlines(&decoder, &row, 1);
+    }
+    jpeg_finish_decompress(&decoder);
+    jpeg_destroy_decompress(&decoder);
+    return 1;
+}
+
+int decode_texture_rgb(const unsigned char* data, size_t size, TextureDecodedRGB* output)
+{
+    if (!output)
+        return 0;
+    output->pixels = NULL;
+    output->width = 0;
+    output->height = 0;
+    if (!data || size < 3)
+        return 0;
+    if (size >= 8 && png_sig_cmp((png_const_bytep)data, 0, 8) == 0)
+        return decode_png(data, size, output);
+    if (data[0] == 0xff && data[1] == 0xd8)
+        return decode_jpeg(data, size, output);
+    return 0;
+}
+
+void free_texture_decoded_rgb(TextureDecodedRGB* image)
+{
+    if (image) {
+        free(image->pixels);
+        image->pixels = NULL;
+        image->width = 0;
+        image->height = 0;
+    }
+}
