+from unittest.mock import Mock, patch
+from urllib.error import HTTPError
+from urllib.parse import parse_qs, urlsplit
+from urllib.request import urlopen
+
+
+BRIDGE_SCRIPT = Path(__file__).resolve().parents[1] / "anycubic_lan_daemon.py"
+
+
+def load_bridge(token_argument):
+    old_argv = sys.argv
+    old_ip = os.environ.get("ORCACUBIC_PRINTER_IP")
+    old_token = os.environ.get("ORCACUBIC_BRIDGE_TOKEN")
+    try:
+        sys.argv = [str(BRIDGE_SCRIPT), "127.0.0.1", token_argument]
+        os.environ.pop("ORCACUBIC_PRINTER_IP", None)
+        os.environ.pop("ORCACUBIC_BRIDGE_TOKEN", None)
+        spec = importlib.util.spec_from_file_location("anycubic_lan_daemon_test", BRIDGE_SCRIPT)
+        bridge = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(bridge)
+        return bridge
+    finally:
+        sys.argv = old_argv
+        if old_ip is None:
+            os.environ.pop("ORCACUBIC_PRINTER_IP", None)
+        else:
+            os.environ["ORCACUBIC_PRINTER_IP"] = old_ip
+        if old_token is None:
+            os.environ.pop("ORCACUBIC_BRIDGE_TOKEN", None)
+        else:
+            os.environ["ORCACUBIC_BRIDGE_TOKEN"] = old_token
+
+
+class KobraXBridgeTest(unittest.TestCase):
+    def test_mqtt_worker_uses_exchanged_credentials(self):
+        bridge = load_bridge("synthetic-bridge-token")
+        bridge.creds = {"username": "synthetic-user", "password": "synthetic-password"}
+        client = Mock()
+        client.loop_start.side_effect = bridge.shutdown_event.set
+        with patch.object(bridge, "fetch_credentials", return_value=True), \
+                patch.object(bridge.mqtt, "Client", return_value=client) as make_client:
+            bridge.mqtt_worker()
+
+        self.assertEqual(make_client.call_args.args[0], bridge.mqtt.CallbackAPIVersion.VERSION2)
+        self.assertTrue(make_client.call_args.kwargs["client_id"].startswith("orca-daemon-"))
+        client.username_pw_set.assert_called_once_with("synthetic-user", "synthetic-password")
+        client.tls_set.assert_called_once_with(cert_reqs=ssl.CERT_NONE)
+        client.tls_insecure_set.assert_called_once_with(True)
+        self.assertIs(client.on_connect, bridge.on_mqtt_connect)
+        self.assertIs(client.on_disconnect, bridge.on_mqtt_disconnect)
+        self.assertIs(client.on_message, bridge.on_mqtt_message)
+        client.connect.assert_called_once_with("127.0.0.1", bridge.PRINTER_MQTT_PORT, 60)
+        client.loop_start.assert_called_once_with()
+
+    def test_mqtt_connection_state(self):
+        bridge = load_bridge("synthetic-bridge-token")
+        bridge.model_id = "20030"
+        bridge.device_id = "synthetic-device"
+        client = Mock()
+        bridge.mqtt_client = client
+        denied = bridge.mqtt.ReasonCode(bridge.mqtt.PacketTypes.CONNACK, "Not authorized")
+        accepted = bridge.mqtt.ReasonCode(bridge.mqtt.PacketTypes.CONNACK, "Success")
+
+        bridge.on_mqtt_connect(client, None, None, denied)
+        self.assertFalse(bridge.telemetry["connected"])
+        client.subscribe.assert_not_called()
+        client.publish.assert_not_called()
+
+        bridge.on_mqtt_connect(client, None, None, accepted)
+        self.assertTrue(bridge.telemetry["connected"])
+        client.subscribe.assert_called_once_with(
+            "anycubic/anycubicCloud/v1/printer/public/20030/synthetic-device/#"
+        )
+        bridge.on_mqtt_disconnect(client, None, None, 0)
+        self.assertFalse(bridge.telemetry["connected"])
+
+    def test_token_file_argument(self):
+        with tempfile.TemporaryDirectory() as directory:
+            token_path = Path(directory) / "bridge.token"
+            token_path.write_text("synthetic-bridge-token\n", encoding="ascii")
+            bridge = load_bridge("@" + str(token_path))
+
+        self.assertEqual(bridge.BRIDGE_TOKEN, "synthetic-bridge-token")
+        self.assertEqual(bridge.PRINTER_IP, "127.0.0.1")
+
+    def test_status_requires_token(self):
+        bridge = load_bridge("synthetic-bridge-token")
+        server = HTTPServer(("127.0.0.1", 0), bridge.BridgeServer)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        base_url = f"http://127.0.0.1:{server.server_port}"
+        try:
+            with urlopen(base_url + "/health", timeout=3) as response:
+                self.assertEqual(response.status, 200)
+            with self.assertRaises(HTTPError) as error:
+                urlopen(base_url + "/status", timeout=3)
+            self.assertEqual(error.exception.code, 403)
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+
+    def test_signed_http_key_exchange(self):
+        bridge = load_bridge("synthetic-bridge-token")
+        printer_token = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef"
+        iv = "0123456789abcdef"
+        credentials = {
+            "modelId": 20030,
+            "deviceId": "synthetic-device",
+            "username": "synthetic-user",
+            "password": "synthetic-password",
+        }
+        plain = json.dumps(credentials).encode()
+        encryptor = bridge.pyaes.Encrypter(
+            bridge.pyaes.AESModeOfOperationCBC(printer_token[16:].encode(), iv=iv.encode())
+        )
+        ciphertext = encryptor.feed(plain) + encryptor.feed()
+        seen = []
+
+        class MockPrinter(BaseHTTPRequestHandler):
+            def do_GET(self):
+                self.assert_request(self.path == "/info")
+                seen.append("info")
+                self.respond({"token": printer_token, "modelId": 20030,
+                              "deviceName": "Mock Kobra X"})
+
+            def do_POST(self):
+                url = urlsplit(self.path)
+                query = parse_qs(url.query)
+                self.assert_request(url.path == "/ctrl")
+                self.assert_request(query.get("did") == ["orca-bridge"])
+                self.assert_request(len(query.get("nonce", [""])[0]) == 6)
+                self.assert_request(self.headers.get("User-Agent") == "AnycubicSlicerNext/2.0.0.2")
+                self.assert_request(self.headers.get("Content-Length") == "0")
+                expected = hashlib.md5(
+                    (hashlib.md5(printer_token[:16].encode()).hexdigest()
+                     + query["ts"][0] + query["nonce"][0]).encode()
+                ).hexdigest()
+                self.assert_request(query.get("sign") == [expected])
+                seen.append("ctrl")
+                self.respond({"data": {"token": iv,
+                                        "info": base64.b64encode(ciphertext).decode()}})
+
+            def assert_request(self, condition):
+                if not condition:
+                    raise AssertionError("Unexpected Kobra X mock request")
+
+            def respond(self, payload):
+                body = json.dumps(payload).encode()
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *_args):
+                pass
+
+        server = HTTPServer(("127.0.0.1", 0), MockPrinter)
+        bridge.PRINTER_HTTP_PORT = server.server_port
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            self.assertTrue(bridge.fetch_credentials())
+            self.assertEqual(seen, ["info", "ctrl"])
+            self.assertEqual(bridge.creds, credentials)
+            self.assertEqual(bridge.model_id, "20030")
+            self.assertEqual(bridge.device_id, "synthetic-device")
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+
+    def test_upload_and_local_print_message(self):
+        bridge = load_bridge("synthetic-bridge-token")
+        bridge.model_id = "20030"
