+#include "SkipPartContours.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <limits>
+#include <unordered_map>
+
+namespace Slic3r::GUI {
+namespace {
+
+struct Edge {
+    std::size_t from;
+    std::size_t to;
+    int direction; // east, south, west, north (image coordinates)
+    bool used = false;
+};
+
+std::uint32_t pixel_id(const unsigned char* rgb, std::size_t pixel)
+{
+    const auto* p = rgb + 3 * pixel;
+    return std::uint32_t(p[0]) | (std::uint32_t(p[1]) << 8) | (std::uint32_t(p[2]) << 16);
+}
+
+long long twice_area(const std::vector<MaskPoint>& ring)
+{
+    long long area = 0;
+    for (std::size_t i = 0; i < ring.size(); ++i) {
+        const auto& a = ring[i];
+        const auto& b = ring[(i + 1) % ring.size()];
+        area += static_cast<long long>(a.x) * b.y - static_cast<long long>(b.x) * a.y;
+    }
+    return area;
+}
+
+void remove_straight_vertices(std::vector<MaskPoint>& ring)
+{
+    if (ring.size() < 3)
+        return;
+    std::vector<MaskPoint> compact;
+    compact.reserve(ring.size());
+    for (std::size_t i = 0; i < ring.size(); ++i) {
+        const auto& prev = ring[(i + ring.size() - 1) % ring.size()];
+        const auto& here = ring[i];
+        const auto& next = ring[(i + 1) % ring.size()];
+        const long long cross = static_cast<long long>(here.x - prev.x) * (next.y - here.y)
+                              - static_cast<long long>(here.y - prev.y) * (next.x - here.x);
+        if (cross != 0)
+            compact.push_back(here);
+    }
+    ring.swap(compact);
+}
+
+std::vector<std::vector<MaskPoint>> trace_rings(const std::vector<std::size_t>& pixels,
+                                                 const std::vector<int>& labels,
+                                                 int component, int width, int height)
+{
+    const std::size_t vertex_width = std::size_t(width) + 1;
+    auto vertex = [vertex_width](int x, int y) { return std::size_t(y) * vertex_width + x; };
+    auto belongs = [&](int x, int y) {
+        return x >= 0 && y >= 0 && x < width && y < height
+            && labels[std::size_t(y) * width + x] == component;
+    };
+
+    std::vector<Edge> edges;
+    std::unordered_map<std::size_t, std::vector<std::size_t>> outgoing;
+    auto add_edge = [&](std::size_t from, std::size_t to, int direction) {
+        outgoing[from].push_back(edges.size());
+        edges.push_back({from, to, direction, false});
+    };
+    for (std::size_t pixel : pixels) {
+        const int x = static_cast<int>(pixel % width);
+        const int y = static_cast<int>(pixel / width);
+        if (!belongs(x, y - 1)) add_edge(vertex(x, y), vertex(x + 1, y), 0);
+        if (!belongs(x + 1, y)) add_edge(vertex(x + 1, y), vertex(x + 1, y + 1), 1);
+        if (!belongs(x, y + 1)) add_edge(vertex(x + 1, y + 1), vertex(x, y + 1), 2);
+        if (!belongs(x - 1, y)) add_edge(vertex(x, y + 1), vertex(x, y), 3);
+    }
+
+    std::vector<std::vector<MaskPoint>> rings;
+    for (std::size_t first = 0; first < edges.size(); ++first) {
+        if (edges[first].used)
+            continue;
+        std::vector<MaskPoint> ring;
+        std::size_t current = first;
+        bool closed = false;
+        for (std::size_t steps = 0; steps < edges.size(); ++steps) {
+            Edge& edge = edges[current];
+            edge.used = true;
+            ring.push_back({static_cast<int>(edge.from % vertex_width),
+                            static_cast<int>(edge.from / vertex_width)});
+            if (edge.to == edges[first].from) {
+                closed = true;
+                break;
+            }
+            const auto next_it = outgoing.find(edge.to);
+            if (next_it == outgoing.end())
+                break;
+            std::size_t next = edges.size();
+            int best_turn = 4;
+            for (std::size_t candidate : next_it->second) {
+                if (edges[candidate].used)
+                    continue;
+                // Turn right at a shared corner so two loops that touch at
+                // one vertex do not get spliced into a self-intersecting ring.
+                const int turn = (edges[candidate].direction - edge.direction + 4) % 4;
+                const int rank = turn == 1 ? 0 : turn == 0 ? 1 : turn == 3 ? 2 : 3;
+                if (rank < best_turn) {
+                    best_turn = rank;
+                    next = candidate;
+                }
+            }
+            if (next == edges.size())
+                break;
+            current = next;
+        }
+        if (closed) {
+            remove_straight_vertices(ring);
+            if (ring.size() >= 3 && twice_area(ring) != 0)
+                rings.push_back(std::move(ring));
+        }
+    }
+    // Clockwise outer boundary has positive area in top-down image space;
+    // counter-clockwise hole boundaries follow it for mapbox::earcut.
+    std::stable_sort(rings.begin(), rings.end(), [](const auto& a, const auto& b) {
+        return twice_area(a) > twice_area(b);
+    });
+    return rings;
+}
+
+} // namespace
+
+std::vector<MaskComponent> extract_mask_components(const unsigned char* rgb, int width, int height)
+{
+    if (!rgb || width <= 0 || height <= 0
+        || std::size_t(width) > std::numeric_limits<std::size_t>::max() / std::size_t(height))
+        return {};
+
+    const std::size_t count = std::size_t(width) * height;
+    std::vector<int> labels(count, -1);
+    std::vector<MaskComponent> components;
+    for (std::size_t start = 0; start < count; ++start) {
+        if (labels[start] >= 0 || pixel_id(rgb, start) == 0)
+            continue;
+        if (components.size() >= static_cast<std::size_t>(std::numeric_limits<int>::max()))
+            break;
+        const int component = static_cast<int>(components.size());
+        std::vector<std::size_t> pixels{start};
+        labels[start] = component;
+        std::unordered_map<std::uint32_t, std::size_t> counts;
+        for (std::size_t i = 0; i < pixels.size(); ++i) {
+            const std::size_t pixel = pixels[i];
+            ++counts[pixel_id(rgb, pixel)];
+            const int x = static_cast<int>(pixel % width);
+            const int y = static_cast<int>(pixel / width);
+            const std::array<std::pair<int, int>, 4> neighbors = {{{x - 1, y}, {x + 1, y}, {x, y - 1}, {x, y + 1}}};
+            for (const auto& neighbor : neighbors) {
+                if (neighbor.first < 0 || neighbor.second < 0 || neighbor.first >= width || neighbor.second >= height)
+                    continue;
+                const std::size_t next = std::size_t(neighbor.second) * width + neighbor.first;
+                if (labels[next] < 0 && pixel_id(rgb, next) != 0) {
+                    labels[next] = component;
+                    pixels.push_back(next);
+                }
+            }
+        }
+
+        std::uint32_t majority_id = 0;
+        std::size_t majority_count = 0;
+        for (const auto& item : counts) {
+            if (item.second > majority_count) {
+                majority_id = item.first;
+                majority_count = item.second;
+            }
+        }
+        MaskComponent output{majority_id, {}};
+        if (majority_count > pixels.size() / 2)
+            output.rings = trace_rings(pixels, labels, component, width, height);
+        components.push_back(std::move(output));
+    }
+    components.erase(std::remove_if(components.begin(), components.end(), [](const auto& component) {
+        return component.id == 0 || component.rings.empty();
+    }), components.end());
+    return components;
+}
+
+} // namespace Slic3r::GUI
diff --git a/src/slic3r/GUI/SkipPartContours.hpp b/src/slic3r/GUI/SkipPartContours.hpp
new file mode 100644
index 00000000..0acbc074
