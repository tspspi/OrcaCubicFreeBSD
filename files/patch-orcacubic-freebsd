+
+        server = HTTPServer(("127.0.0.1", 0), MockPrinter)
+        bridge.telemetry["upload_url"] = f"http://127.0.0.1:{server.server_port}/gcode_upload"
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            with patch.object(bridge.time, "sleep"):
+                result = bridge.upload_and_start_print_file(
+                    gcode, "../synthetic.gcode", use_ams=False,
+                    task_settings={"auto_leveling": 0},
+                )
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+
+        self.assertEqual(result["status"], "ok")
+        self.assertEqual(result["filename"], "synthetic.gcode")
+        self.assertEqual(len(uploads), 1)
+        path, headers, body = uploads[0]
+        self.assertEqual(path, "/gcode_upload")
+        self.assertEqual(headers["X-File-Length"], str(len(gcode)))
+        self.assertIn(b'filename="synthetic.gcode"', body)
+        self.assertIn(gcode, body)
+        bridge.mqtt_client.publish.assert_called_once()
+        topic, message = bridge.mqtt_client.publish.call_args.args
+        self.assertEqual(topic, "anycubic/anycubicCloud/v1/slicer/printer/20030/synthetic-device/print")
+        start = json.loads(message)
+        self.assertEqual(start["action"], "start")
+        self.assertEqual(start["data"]["filetype"], 1)
+        self.assertEqual(start["data"]["filename"], "synthetic.gcode")
+        self.assertEqual(start["data"]["md5"], hashlib.md5(gcode).hexdigest())
+        self.assertEqual(start["data"]["filesize"], len(gcode))
+        self.assertFalse(start["data"]["ams_settings"]["use_ams"])
+        self.assertEqual(start["data"]["task_settings"]["auto_leveling"], 0)
+
+    def test_upload_rejection_does_not_start_print(self):
+        bridge = load_bridge("synthetic-bridge-token")
+        bridge.telemetry["connected"] = True
+        bridge.mqtt_client = Mock()
+
+        class RejectingPrinter(BaseHTTPRequestHandler):
+            def do_POST(self):
+                self.rfile.read(int(self.headers["Content-Length"]))
+                body = b'{"code": 400, "message": "synthetic rejection"}'
+                self.send_response(200)
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *_args):
+                pass
+
+        server = HTTPServer(("127.0.0.1", 0), RejectingPrinter)
+        bridge.telemetry["upload_url"] = f"http://127.0.0.1:{server.server_port}/gcode_upload"
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            result = bridge.upload_and_start_print_file(b"; test\n", "synthetic.gcode")
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+
+        self.assertEqual(result, {"status": "error", "message": "synthetic rejection"})
+        bridge.mqtt_client.publish.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
