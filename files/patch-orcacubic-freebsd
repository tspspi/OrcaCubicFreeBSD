@@ -0,0 +1,52 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include "libslic3r/ObjColorUtils.hpp"
+
+#include <cassert>
+
+int main()
+{
+    std::vector<Slic3r::RGBA> colors = {
+        {1.f, 0.f, 0.f, 1.f}, {1.f, 0.f, 0.f, 1.f},
+        {0.f, 0.f, 1.f, 1.f}, {0.f, 0.f, 1.f, 1.f}
+    };
+    std::vector<Slic3r::RGBA> centers;
+    std::vector<int> labels;
+    char requested = 2;
+    assert(obj_color_deal_algo(colors, centers, labels, requested, 4));
+    assert(centers.size() == 2 && labels.size() == colors.size());
+    assert(labels[0] == labels[1] && labels[2] == labels[3]);
+    assert(labels[0] != labels[2]);
+    assert(centers[labels[0]][0] > 0.9f && centers[labels[0]][2] < 0.1f);
+    assert(centers[labels[2]][2] > 0.9f && centers[labels[2]][0] < 0.1f);
+
+    requested = -1;
+    assert(obj_color_deal_algo(colors, centers, labels, requested, 2));
+    assert(centers.size() == 2 && labels.size() == colors.size());
+
+    requested = 1;
+    assert(obj_color_deal_algo(colors, centers, labels, requested, 4));
+    assert(centers.size() == 1 && labels.size() == colors.size());
+    for (int label : labels)
+        assert(label == 0);
+
+    requested = 4;
+    assert(obj_color_deal_algo(colors, centers, labels, requested, 2));
+    assert(centers.size() == 2);
+    for (int label : labels)
+        assert(label >= 0 && label < static_cast<int>(centers.size()));
+
+    colors.assign(9, {1.f, 0.f, 0.f, 1.f});
+    colors.push_back({0.f, 0.f, 1.f, 1.f});
+    requested = 1;
+    assert(obj_color_deal_algo(colors, centers, labels, requested, 4));
+    assert(centers.size() == 1 && labels.size() == colors.size());
+    assert(centers[0][0] > 0.85f && centers[0][2] < 0.15f);
+
+    colors.clear();
+    assert(!obj_color_deal_algo(colors, centers, labels, requested, 4));
+    assert(centers.empty() && labels.empty());
+    return 0;
+}
