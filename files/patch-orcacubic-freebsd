+
+namespace Slic3r::tex2color {
+
+// Three-byte BGR image, stored top-down with no row padding. Keeping the
+// channel order matches the texture sampling code and the old OpenCV path.
+struct RGBImage {
+    int width = 0;
+    int height = 0;
+    std::vector<std::uint8_t> pixels;
+
+    RGBImage() = default;
+    RGBImage(int w, int h) : width(w), height(h), pixels(std::size_t(w) * h * 3, 0) {}
+
+    bool empty() const { return width <= 0 || height <= 0 || pixels.empty(); }
+
+    std::uint8_t* pixel(int row, int col) {
+        return pixels.data() + (std::size_t(row) * width + col) * 3;
+    }
+    const std::uint8_t* pixel(int row, int col) const {
+        return pixels.data() + (std::size_t(row) * width + col) * 3;
+    }
+};
+
+} // namespace Slic3r::tex2color
