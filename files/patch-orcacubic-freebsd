@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace Slic3r::GUI {
+
+struct MaskPoint {
+    int x;
+    int y;
+};
+
+struct MaskComponent {
+    std::uint32_t id;
+    // Outer ring first, followed by any holes. Coordinates are pixel corners.
+    std::vector<std::vector<MaskPoint>> rings;
+};
+
+// Extract selectable regions from a top-down, tightly packed RGB pick image.
+// A region must have a strict majority of one encoded part ID, as in the old
+// OpenCV contour path. Black pixels are background.
+std::vector<MaskComponent> extract_mask_components(const unsigned char* rgb, int width, int height);
+
+} // namespace Slic3r::GUI
diff --git a/tests/SkipPartContoursTest.cpp b/tests/SkipPartContoursTest.cpp
new file mode 100644
index 00000000..65e4c02c
--- /dev/null
+++ b/tests/SkipPartContoursTest.cpp
@@ -0,0 +1,153 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include "slic3r/GUI/SkipPartContours.hpp"
+#include <earcut/earcut.hpp>
+
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <vector>
+
+using Slic3r::GUI::MaskPoint;
+using Slic3r::GUI::extract_mask_components;
+
+static long long area2(const std::vector<MaskPoint>& ring)
+{
+    long long area = 0;
+    for (std::size_t i = 0; i < ring.size(); ++i) {
+        const auto& a = ring[i];
+        const auto& b = ring[(i + 1) % ring.size()];
+        area += static_cast<long long>(a.x) * b.y - static_cast<long long>(b.x) * a.y;
+    }
+    return area;
+}
+
+static void set_pixel(std::vector<unsigned char>& image, int width, int x, int y, unsigned char id)
+{
+    image[3 * (y * width + x)] = id;
+}
+
+int main()
+{
+    {
+        std::vector<unsigned char> image(3 * 4 * 4, 0);
+        for (int y = 1; y <= 2; ++y)
+            for (int x = 1; x <= 2; ++x)
+                set_pixel(image, 4, x, y, 7);
+        auto parts = extract_mask_components(image.data(), 4, 4);
+        assert(parts.size() == 1 && parts[0].id == 7);
+        assert(parts[0].rings.size() == 1);
+        assert(parts[0].rings[0].size() == 4);
+        assert(area2(parts[0].rings[0]) == 8);
+    }
+    {
+        std::vector<unsigned char> image(3 * 5 * 5, 0);
+        for (int y = 0; y < 5; ++y)
+            for (int x = 0; x < 5; ++x)
+                if (x != 2 || y != 2)
+                    set_pixel(image, 5, x, y, 8);
+        auto parts = extract_mask_components(image.data(), 5, 5);
+        assert(parts.size() == 1 && parts[0].id == 8);
+        assert(parts[0].rings.size() == 2);
+        assert(area2(parts[0].rings[0]) == 50);
+        assert(area2(parts[0].rings[1]) == -2);
+        std::vector<std::vector<std::array<float, 2>>> polygon;
+        std::vector<std::array<float, 2>> flat;
+        for (const auto& ring : parts[0].rings) {
+            polygon.emplace_back();
+            for (const auto& point : ring) {
+                std::array<float, 2> p{float(point.x), float(point.y)};
+                polygon.back().push_back(p);
+                flat.push_back(p);
+            }
+        }
+        auto triangles = mapbox::earcut<std::uint32_t>(polygon);
+        long long triangulated_area2 = 0;
+        for (std::size_t i = 0; i < triangles.size(); i += 3) {
+            const auto& a = flat[triangles[i]];
+            const auto& b = flat[triangles[i + 1]];
+            const auto& c = flat[triangles[i + 2]];
+            const long long twice = static_cast<long long>((b[0] - a[0]) * (c[1] - a[1])
+                                                        - (c[0] - a[0]) * (b[1] - a[1]));
+            triangulated_area2 += twice < 0 ? -twice : twice;
+        }
+        assert(triangulated_area2 == 48);
+    }
+    {
+        std::vector<unsigned char> image(3 * 3, 0);
+        set_pixel(image, 3, 0, 0, 9);
+        set_pixel(image, 3, 2, 0, 10);
+        auto parts = extract_mask_components(image.data(), 3, 1);
+        assert(parts.size() == 2);
+        assert(parts[0].id == 9 && parts[1].id == 10);
+    }
+    {
+        std::vector<unsigned char> image(3 * 3, 0);
+        set_pixel(image, 3, 0, 0, 11);
+        set_pixel(image, 3, 1, 0, 11);
+        set_pixel(image, 3, 2, 0, 12);
+        auto parts = extract_mask_components(image.data(), 3, 1);
+        assert(parts.size() == 1 && parts[0].id == 11);
+        set_pixel(image, 3, 2, 0, 12);
+        set_pixel(image, 3, 1, 0, 12);
+        parts = extract_mask_components(image.data(), 3, 1);
+        assert(parts.size() == 1 && parts[0].id == 12);
+    }
+    {
+        std::vector<unsigned char> image(3 * 2, 0);
+        set_pixel(image, 2, 0, 0, 11);
+        set_pixel(image, 2, 1, 0, 12);
+        assert(extract_mask_components(image.data(), 2, 1).empty());
+    }
+    {
+        // Irregular components exercise concave boundaries, touching corners,
+        // and holes beyond the hand-written rectangle cases.
+        std::uint32_t random_state = 0x8375a9d2;
+        for (int case_no = 0; case_no < 1000; ++case_no) {
+            std::vector<unsigned char> image(3 * 16 * 16, 0);
+            int foreground_pixels = 0;
+            for (int y = 0; y < 16; ++y) {
+                for (int x = 0; x < 16; ++x) {
+                    random_state = random_state * 1664525u + 1013904223u;
+                    if ((random_state >> 24) < 115) {
+                        set_pixel(image, 16, x, y, 13);
+                        ++foreground_pixels;
+                    }
+                }
+            }
+            auto parts = extract_mask_components(image.data(), 16, 16);
+            long long total_area2 = 0;
+            for (const auto& part : parts) {
+                assert(part.id == 13);
+                std::vector<std::vector<std::array<float, 2>>> polygon;
+                std::vector<std::array<float, 2>> flat;
+                for (const auto& ring : part.rings) {
+                    total_area2 += area2(ring);
+                    polygon.emplace_back();
+                    for (const auto& point : ring) {
+                        std::array<float, 2> p{float(point.x), float(point.y)};
+                        polygon.back().push_back(p);
+                        flat.push_back(p);
+                    }
+                }
+                const auto triangles = mapbox::earcut<std::uint32_t>(polygon);
+                long long triangles_area2 = 0;
+                for (std::size_t i = 0; i < triangles.size(); i += 3) {
+                    const auto& a = flat[triangles[i]];
+                    const auto& b = flat[triangles[i + 1]];
+                    const auto& c = flat[triangles[i + 2]];
+                    const long long twice = static_cast<long long>((b[0] - a[0]) * (c[1] - a[1])
+                                                                - (c[0] - a[0]) * (b[1] - a[1]));
+                    triangles_area2 += twice < 0 ? -twice : twice;
+                }
+                long long component_area2 = 0;
+                for (const auto& ring : part.rings)
+                    component_area2 += area2(ring);
+                assert(triangles_area2 == component_area2);
+            }
+            assert(total_area2 == foreground_pixels * 2);
+        }
+    }
+}
diff --git a/tests/TextureDecodeTest.c b/tests/TextureDecodeTest.c
new file mode 100644
index 00000000..d8ba07e1
